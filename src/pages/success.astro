---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Enquiry received — NOVEXA DIGITAL" description="Your NOVEXA DIGITAL project enquiry has been received.">
  <PageHero eyebrow="Thank you" title="Your enquiry has been received." intro="We’ll review what you shared and respond with a useful next step." />
  <section class="section paper">
    <div class="narrow">
      <h2 class="h2">What happens next</h2>
      <p class="lead">We’ll check the context, identify any immediate questions and reply by email.</p>
      <p class="muted">Please do not send passwords, patient information or other sensitive material by ordinary email. If secure access is needed, we’ll arrange the appropriate method.</p>
      <a class="btn btn-outline" href="/">Return home</a>
    </div>
  </section>
</Layout>
