---
import Layout from '../layouts/Layout.astro'; import PageHero from '../components/PageHero.astro';
const steps=[['01','Frame','We clarify the decision, audience, constraints and useful outcome before defining the work.'],['02','Shape','Structure, messages and creative direction are developed together so the experience has a sound foundation.'],['03','Build','Approved direction moves into production with visible milestones, direct communication and quality checks.'],['04','Refine','Feedback is consolidated into two included revision rounds unless the proposal specifies otherwise.'],['05','Launch & transfer','We complete launch checks, provide agreed files and access, and explain what your team owns and manages.']];
---
<Layout title="Process — NOVEXA DIGITAL" description="A clear, collaborative digital project process from discovery and design through launch, ownership and warranty.">
<PageHero eyebrow="Process" title="A transparent path from decision to delivery." intro="Enough structure to protect the outcome. Enough flexibility to respond to what we learn." />
<section class="section paper"><div class="container">{steps.map(([n,t,d]) => <article class="process-step reveal"><div class="step-no">{n}</div><div><h2 class="h3">{t}</h2><p>{d}</p></div></article>)}</div></section>
<section class="section dark"><div class="container split"><div><p class="eyebrow">Working together</p><h2 class="h2">Clear roles keep projects moving.</h2></div><div class="rule-list" style="border-color:rgba(255,255,255,.18)"><div class="rule" style="border-color:rgba(255,255,255,.18)"><span>Us</span><strong>Direction & delivery</strong><p>NOVEXA leads the agreed strategy, design, build, communication and quality control.</p></div><div class="rule" style="border-color:rgba(255,255,255,.18)"><span>You</span><strong>Context & decisions</strong><p>You provide source material, stakeholder access, consolidated feedback and approvals on time.</p></div><div class="rule" style="border-color:rgba(255,255,255,.18)"><span>Both</span><strong>Shared clarity</strong><p>Risks, changes and decisions are surfaced early rather than buried in the final stretch.</p></div></div></div></section>
<section class="section white"><div class="container split"><div><p class="eyebrow">After launch</p><h2 class="h2">Handover, not handcuffs.</h2></div><div><p class="lead">The project closes with documented access and a clear ownership position.</p><p class="muted">A 30-day workmanship warranty covers defects against the approved scope. Optional support is available at $120 per hour + GST for enhancements, advice and work outside warranty. There is no obligation to retain us.</p><a class="btn btn-outline" href="/contact/">Plan your project</a></div></div></section>
</Layout>
